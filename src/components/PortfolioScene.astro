---
// Bruno Simon-style drivable 3D portfolio lot for the portfolio page.
// Rendered client-side with Three.js (bundled via npm, no CDN) so the
// site's strict Content-Security-Policy is respected. A low-poly car
// (styled after the Quadra Turbo-R V-Tech from Cyberpunk 2077) drives
// around a neon lot; parking on a glowing zone pad opens the highlight
// panel with that section's content (same panel as before).
// Arcade physics are hand-rolled — no extra dependencies. Terrain is a
// height model sampled from the two wedge ramps, so the ramps are fully
// drivable: climb them, launch off the lip, land with a settle.
// All copy is reused from the portfolio page itself: no phone, no email,
// no address, no family details, no casework specifics. Contact = LinkedIn.
---

<div class="portfolio-scene-wrap" id="drive-wrap" data-version="drive-v2">
  <canvas id="drive-scene" aria-hidden="true"></canvas>
  <div id="drive-overlay" class="scene-overlay">
    <p class="scene-overlay-title">Click to drive</p>
    <p class="scene-overlay-sub">
      Explore the lot — park on a glowing zone pad to open each section,
      and hit the ramps at speed to catch air.
    </p>
    <ul class="scene-overlay-keys">
      <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrow keys — drive &amp; steer</li>
      <li><kbd>Space</kbd> — brake</li>
      <li><kbd>R</kbd> — reset car</li>
      <li><kbd>Esc</kbd> — release controls</li>
    </ul>
  </div>
  <button id="drive-exit" class="scene-exit" type="button" hidden>Exit driving ×</button>
  <div id="drive-touch" class="scene-touch" hidden>
    <div class="touch-group">
      <button type="button" data-k="left" aria-label="Steer left">◀</button>
      <button type="button" data-k="right" aria-label="Steer right">▶</button>
    </div>
    <div class="touch-group">
      <button type="button" data-k="down" aria-label="Reverse">▼</button>
      <button type="button" data-k="up" aria-label="Accelerate">▲</button>
    </div>
  </div>
  <noscript>
    <p class="scene-fallback">Interactive 3D scene requires JavaScript.</p>
  </noscript>
</div>
<p class="scene-hint" id="drive-hint">
  Click the lot to drive. Park on a glowing zone pad — About, Certifications,
  Experience, Projects, or Contact — to open its panel. Everything is also
  written out in the sections below.
</p>
<div id="scene-panel" class="scene-panel" aria-live="polite" hidden>
  <button id="scene-panel-close" class="scene-panel-close" type="button" aria-label="Close highlight">×</button>
  <p id="scene-panel-kicker" class="scene-panel-kicker"></p>
  <p id="scene-panel-title" class="scene-panel-title"></p>
  <p id="scene-panel-text" class="scene-panel-text"></p>
</div>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("drive-scene");
  if (canvas) {
    try {
      const wrap = document.getElementById("drive-wrap");
      const overlay = document.getElementById("drive-overlay");
      const exitBtn = document.getElementById("drive-exit");
      const touchUI = document.getElementById("drive-touch");
      const hint = document.getElementById("drive-hint");
      const panel = document.getElementById("scene-panel");
      const panelKicker = document.getElementById("scene-panel-kicker");
      const panelTitle = document.getElementById("scene-panel-title");
      const panelText = document.getElementById("scene-panel-text");
      const panelClose = document.getElementById("scene-panel-close");

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isTouch = window.matchMedia("(pointer: coarse)").matches;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.setClearColor(0x050914);

      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(0x050914, 55, 130);
      const camera = new THREE.PerspectiveCamera(58, 1, 0.1, 300);

      // ---- Lighting -----------------------------------------------------
      scene.add(new THREE.HemisphereLight(0x8ab4ff, 0x0b1020, 0.85));
      const sun = new THREE.DirectionalLight(0xdbeafe, 1.6);
      sun.position.set(30, 44, 18);
      sun.castShadow = true;
      sun.shadow.mapSize.set(1024, 1024);
      sun.shadow.camera.left = -52;
      sun.shadow.camera.right = 52;
      sun.shadow.camera.top = 52;
      sun.shadow.camera.bottom = -52;
      sun.shadow.camera.near = 1;
      sun.shadow.camera.far = 130;
      sun.shadow.bias = -0.0006;
      scene.add(sun);

      // ---- Soft radial glow texture (canvas, no external asset) ---------
      const makeGlowTexture = () => {
        const c = document.createElement("canvas");
        c.width = 128;
        c.height = 128;
        const ctx = c.getContext("2d");
        const g = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
        g.addColorStop(0, "rgba(255,255,255,1)");
        g.addColorStop(0.4, "rgba(255,255,255,0.45)");
        g.addColorStop(1, "rgba(255,255,255,0)");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, 128, 128);
        return new THREE.CanvasTexture(c);
      };
      const glowTexture = makeGlowTexture();

      // ---- Ground: canvas-textured lot with a road cross ----------------
      const LOT = 44; // half-size of the drivable lot
      const makeGroundTexture = () => {
        const c = document.createElement("canvas");
        c.width = 1024;
        c.height = 1024;
        const ctx = c.getContext("2d");
        ctx.fillStyle = "#0a0f1e";
        ctx.fillRect(0, 0, 1024, 1024);
        // Speckle
        for (let i = 0; i < 4200; i++) {
          ctx.fillStyle = `rgba(148,197,255,${Math.random() * 0.05})`;
          ctx.fillRect(Math.random() * 1024, Math.random() * 1024, 2, 2);
        }
        // Faint grid
        ctx.strokeStyle = "rgba(96,165,250,0.05)";
        ctx.lineWidth = 1;
        for (let i = 0; i <= 1024; i += 64) {
          ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(1024, i); ctx.stroke();
        }
        // Road cross (98px ≈ 8 world units wide)
        ctx.fillStyle = "#0e1730";
        ctx.fillRect(463, 0, 98, 1024);
        ctx.fillRect(0, 463, 1024, 98);
        // Dashed centre lines
        ctx.strokeStyle = "rgba(103,232,249,0.28)";
        ctx.lineWidth = 4;
        ctx.setLineDash([20, 16]);
        ctx.beginPath(); ctx.moveTo(512, 0); ctx.lineTo(512, 1024); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, 512); ctx.lineTo(1024, 512); ctx.stroke();
        ctx.setLineDash([]);
        // Parking ticks along east/west edges
        ctx.fillStyle = "rgba(226,232,240,0.13)";
        for (let y = 60; y < 1000; y += 84) {
          ctx.fillRect(18, y, 46, 5);
          ctx.fillRect(960, y, 46, 5);
        }
        const tex = new THREE.CanvasTexture(c);
        tex.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
        return tex;
      };
      const ground = new THREE.Mesh(
        new THREE.PlaneGeometry(LOT * 2, LOT * 2),
        new THREE.MeshStandardMaterial({ map: makeGroundTexture(), roughness: 0.95, metalness: 0 })
      );
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      // ---- Perimeter walls with a neon top strip ------------------------
      const wallMat = new THREE.MeshStandardMaterial({ color: 0x111c38, roughness: 0.8 });
      const stripMat = new THREE.MeshBasicMaterial({ color: 0x22d3ee });
      const addWall = (x, z, w, d) => {
        const wall = new THREE.Mesh(new THREE.BoxGeometry(w, 1.1, d), wallMat);
        wall.position.set(x, 0.55, z);
        wall.castShadow = true;
        wall.receiveShadow = true;
        scene.add(wall);
        const strip = new THREE.Mesh(new THREE.BoxGeometry(w, 0.09, d), stripMat);
        strip.position.set(x, 1.15, z);
        scene.add(strip);
      };
      addWall(0, -LOT, LOT * 2 + 1, 1);
      addWall(0, LOT, LOT * 2 + 1, 1);
      addWall(-LOT, 0, 1, LOT * 2 + 1);
      addWall(LOT, 0, 1, LOT * 2 + 1);

      // ---- Props & obstacles ----------------------------------------------
      // Obstacles are AABBs the (circular) car collides with. Tippable props
      // animate a fall on impact and then stop colliding.
      const obstacles = [];
      const addObstacle = (mesh, x, z, hx, hz, tippable) => {
        mesh.position.x = x;
        mesh.position.z = z;
        scene.add(mesh);
        obstacles.push({ mesh, x, z, hx, hz, tippable: !!tippable, dead: false, tipT: -1, tipAxis: "x", tipDir: 1 });
        return mesh;
      };

      const coneMat = new THREE.MeshStandardMaterial({ color: 0xf97316, roughness: 0.6 });
      const coneStripeMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.5 });
      const makeCone = () => {
        const g = new THREE.Group();
        const base = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.08, 0.7), coneMat);
        base.position.y = 0.04;
        g.add(base);
        const body = new THREE.Mesh(new THREE.ConeGeometry(0.34, 0.95, 14), coneMat);
        body.position.y = 0.55;
        body.castShadow = true;
        g.add(body);
        const stripe = new THREE.Mesh(new THREE.CylinderGeometry(0.21, 0.26, 0.18, 14), coneStripeMat);
        stripe.position.y = 0.55;
        g.add(stripe);
        return g;
      };
      const crateMat = new THREE.MeshStandardMaterial({ color: 0x8a6b3f, roughness: 0.9 });
      const crateEdgeMat = new THREE.MeshStandardMaterial({ color: 0x5f4a2a, roughness: 0.9 });
      const makeCrate = () => {
        const g = new THREE.Group();
        const box = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.4, 1.4), crateMat);
        box.position.y = 0.7;
        box.castShadow = true;
        box.receiveShadow = true;
        g.add(box);
        const lid = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.1, 1.5), crateEdgeMat);
        lid.position.y = 1.42;
        g.add(lid);
        return g;
      };
      const barrierMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.7 });
      const barrierStripeMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
      const makeBarrier = () => {
        const g = new THREE.Group();
        const bar = new THREE.Mesh(new THREE.BoxGeometry(4.4, 0.5, 0.35), barrierMat);
        bar.position.y = 0.75;
        bar.castShadow = true;
        g.add(bar);
        const stripe = new THREE.Mesh(new THREE.BoxGeometry(4.42, 0.14, 0.37), barrierStripeMat);
        stripe.position.y = 0.75;
        g.add(stripe);
        [-1.9, 1.9].forEach((dx) => {
          const leg = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.55, 0.5), barrierMat);
          leg.position.set(dx, 0.27, 0);
          g.add(leg);
        });
        return g;
      };
      const poleMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.5, metalness: 0.6 });
      const makeLightPole = (color) => {
        const g = new THREE.Group();
        const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.12, 5.4, 8), poleMat);
        pole.position.y = 2.7;
        pole.castShadow = true;
        g.add(pole);
        const lamp = new THREE.Mesh(
          new THREE.SphereGeometry(0.3, 12, 12),
          new THREE.MeshBasicMaterial({ color })
        );
        lamp.position.y = 5.5;
        g.add(lamp);
        const glow = new THREE.Sprite(
          new THREE.SpriteMaterial({ map: glowTexture, color, transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending, depthWrite: false })
        );
        glow.scale.setScalar(2.6);
        glow.position.y = 5.5;
        g.add(glow);
        return g;
      };
      // ---- Ramps: true wedge geometry with a matching height model --------
      // Each ramp is a prism: RAMP_L long along its uphill direction,
      // RAMP_W wide, rising linearly from 0 to RAMP_H. The physics height
      // model (groundHeightAt) uses the exact same profile, so what you
      // see is precisely what the car rides on.
      const RAMP_L = 5.4, RAMP_W = 3.6, RAMP_H = 1.15;
      const makeWedgeGeometry = (L, W, H) => {
        const hw = W / 2;
        const A = [-L / 2, 0], B = [L / 2, 0], C = [L / 2, H];
        const tris = [];
        const quad = (p1, p2, p3, p4) => { tris.push(...p1, ...p2, ...p3, ...p1, ...p3, ...p4); };
        const tri = (p1, p2, p3) => { tris.push(...p1, ...p2, ...p3); };
        // Slope face (A -> C) and the vertical back face (B -> C).
        quad([A[0], A[1], -hw], [A[0], A[1], hw], [C[0], C[1], hw], [C[0], C[1], -hw]);
        quad([B[0], B[1], hw], [B[0], B[1], -hw], [C[0], C[1], -hw], [C[0], C[1], hw]);
        // Side triangles.
        tri([A[0], A[1], -hw], [B[0], B[1], -hw], [C[0], C[1], -hw]);
        tri([A[0], A[1], hw], [C[0], C[1], hw], [B[0], B[1], hw]);
        const geo = new THREE.BufferGeometry();
        geo.setAttribute("position", new THREE.Float32BufferAttribute(tris, 3));
        geo.computeVertexNormals();
        return geo;
      };
      const rampMat = new THREE.MeshStandardMaterial({ color: 0x1c2a4a, roughness: 0.85, side: THREE.DoubleSide });
      const ramps = [];
      const addRamp = (x, z, rotY) => {
        const g = new THREE.Group();
        const wedge = new THREE.Mesh(makeWedgeGeometry(RAMP_L, RAMP_W, RAMP_H), rampMat);
        wedge.castShadow = true;
        wedge.receiveShadow = true;
        g.add(wedge);
        const lip = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.09, RAMP_W), barrierStripeMat);
        lip.position.set(RAMP_L / 2 - 0.12, RAMP_H + 0.02, 0);
        g.add(lip);
        g.position.set(x, 0, z);
        g.rotation.y = rotY;
        scene.add(g);
        // Uphill unit vector U = local +x after rotY; width vector V = local +z.
        ramps.push({
          x, z,
          ux: Math.cos(rotY), uz: -Math.sin(rotY),
          vx: Math.sin(rotY), vz: Math.cos(rotY),
        });
        return g;
      };
      // Ground height under a point: the flat lot is 0; inside a ramp's
      // footprint the wedge profile applies. Max of contributing surfaces.
      const groundHeightAt = (x, z) => {
        let h = 0;
        for (const r of ramps) {
          const dx = x - r.x;
          const dz = z - r.z;
          const s = dx * r.ux + dz * r.uz;
          if (s < -RAMP_L / 2 || s > RAMP_L / 2) continue;
          const w = dx * r.vx + dz * r.vz;
          if (w < -RAMP_W / 2 || w > RAMP_W / 2) continue;
          const rh = ((s + RAMP_L / 2) / RAMP_L) * RAMP_H;
          if (rh > h) h = rh;
        }
        return h;
      };

      // Cones: slalom lines down the road cross + a few clusters.
      [[-5.6, -14], [5.6, -14], [-5.6, -6], [5.6, -6], [-14, -5.6], [-6, -5.6], [-14, 5.6], [-6, 5.6],
       [12, 12], [14.5, 12], [-20, -18], [20, 16], [-12, 30], [16, -34]].forEach(([x, z]) =>
        addObstacle(makeCone(), x, z, 0.42, 0.42, true));
      // Crates: two clusters + singles.
      addObstacle(makeCrate(), 15, 5, 0.8, 0.8, true);
      addObstacle(makeCrate(), 16.6, 5.2, 0.8, 0.8, true);
      addObstacle(makeCrate(), -17, -9, 0.8, 0.8, true);
      addObstacle(makeCrate(), -17.2, -10.6, 0.8, 0.8, true);
      addObstacle(makeCrate(), 20, -31, 0.8, 0.8, true);
      addObstacle(makeCrate(), -34, 12, 0.8, 0.8, true);
      // Barriers.
      const b1 = addObstacle(makeBarrier(), 0, -18, 2.3, 0.45, false);
      const b2 = addObstacle(makeBarrier(), -15, 16, 2.3, 0.45, false);
      b2.rotation.y = Math.PI / 2; b2.userData.rot = true; // swap AABB below
      obstacles[obstacles.length - 1].hx = 0.45; obstacles[obstacles.length - 1].hz = 2.3;
      const b3 = addObstacle(makeBarrier(), 33, -6, 2.3, 0.45, false);
      b3.rotation.y = Math.PI / 2;
      obstacles[obstacles.length - 1].hx = 0.45; obstacles[obstacles.length - 1].hz = 2.3;
      // Light poles near the corners and mid-edges.
      addObstacle(makeLightPole(0x67e8f9), -38, -38, 0.35, 0.35, false);
      addObstacle(makeLightPole(0xf59e0b), 38, -38, 0.35, 0.35, false);
      addObstacle(makeLightPole(0xa78bfa), 38, 38, 0.35, 0.35, false);
      addObstacle(makeLightPole(0x67e8f9), -38, 38, 0.35, 0.35, false);
      addObstacle(makeLightPole(0xfbbf24), 0, 38, 0.35, 0.35, false);
      // Ramps: drivable wedges (see the height model above). The second
      // one is rotated PI, so its slope climbs toward -x.
      addRamp(35, 10, 0);
      addRamp(-35, -18, Math.PI);

      // ---- Portfolio zones --------------------------------------------------
      const ZONES = [
        {
          id: "about", label: "ABOUT", title: "About", color: 0x22d3ee, x: -27, z: -25,
          text: "I started in telecom customer care, where I learned to listen for patterns — the pause before a lie, the account that didn't add up, the voice asking for help without asking. That instinct became OSINT. I went back to school, earned my degree in Information Technology with a specialization in Information Assurance and Cybersecurity, and began building toward analyst work that supports law enforcement against traffickers and predators.",
        },
        {
          id: "certifications", label: "CERTIFICATIONS", title: "Certifications", color: 0xf59e0b, x: 27, z: -25,
          text: "Practical OSINT Research Professional (PORP) — TCM Security · Google IT Support — Google · Practical Help Desk Associate (PHDA) — TCM Security, in progress.",
        },
        {
          id: "experience", label: "EXPERIENCE", title: "Experience", color: 0xa78bfa, x: 27, z: 24,
          text: "Expert, Loyalty — T-Mobile (2025–present; previously Technical Expert, 2024–2025) · Volunteer OSINT Analyst — Skull Games Task Force (since October 2026) · OSINT Intern — The OSINT Insider (since September 2026) · Global OSINT Search Party CTF Participant — Trace Labs (August 2026).",
        },
        {
          id: "projects", label: "PROJECTS", title: "Projects", color: 0x60a5fa, x: -27, z: 24,
          text: "OSINT Journey blog — ongoing writing on OSINT research, certifications, CTFs, and counter-trafficking — what I learn, what I get wrong, and how I improve. · OSINT research and writing — general open source research, methodology notes, and book and course reviews.",
        },
        {
          id: "contact", label: "CONTACT", title: "Contact", color: 0xe879f9, x: 0, z: -35,
          text: "The best place to reach me professionally is LinkedIn.",
        },
      ];
      const css = (hex) => `#${hex.toString(16).padStart(6, "0")}`;
      const makeLabelSprite = (text, colorHex) => {
        const c = document.createElement("canvas");
        c.width = 512;
        c.height = 128;
        const ctx = c.getContext("2d");
        ctx.fillStyle = "rgba(5,9,20,0.72)";
        ctx.strokeStyle = css(colorHex);
        ctx.lineWidth = 5;
        const r = 26;
        ctx.beginPath();
        ctx.roundRect(10, 22, 492, 84, r);
        ctx.fill();
        ctx.stroke();
        ctx.font = "700 44px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.shadowColor = css(colorHex);
        ctx.shadowBlur = 16;
        ctx.fillStyle = "#f1f5f9";
        ctx.fillText(text, 256, 66);
        const tex = new THREE.CanvasTexture(c);
        const sprite = new THREE.Sprite(
          new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false })
        );
        sprite.scale.set(9.4, 2.35, 1);
        return sprite;
      };
      const zoneObjs = ZONES.map((zone) => {
        const group = new THREE.Group();
        group.position.set(zone.x, 0, zone.z);
        const pad = new THREE.Mesh(
          new THREE.CylinderGeometry(3.4, 3.4, 0.14, 36),
          new THREE.MeshStandardMaterial({ color: 0x0b1226, emissive: zone.color, emissiveIntensity: 0.25, roughness: 0.6 })
        );
        pad.position.y = 0.07;
        pad.receiveShadow = true;
        group.add(pad);
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(3.45, 3.85, 40),
          new THREE.MeshBasicMaterial({ color: zone.color, transparent: true, opacity: 0.9, side: THREE.DoubleSide })
        );
        ring.rotation.x = -Math.PI / 2;
        ring.position.y = 0.16;
        group.add(ring);
        const beam = new THREE.Mesh(
          new THREE.CylinderGeometry(0.16, 0.16, 4.6, 8),
          new THREE.MeshBasicMaterial({ color: zone.color, transparent: true, opacity: 0.55 })
        );
        beam.position.y = 2.3;
        group.add(beam);
        const label = makeLabelSprite(zone.label, zone.color);
        label.position.y = 5.4;
        group.add(label);
        scene.add(group);
        return { zone, group, pad, ring, label, active: false };
      });

      // ---- The car: Quadra Turbo-R V-Tech inspired (Cyberpunk 2077) --------
      // Low, wide wedge silhouette in bright yellow with black/carbon
      // accents, built entirely from Three.js primitives: an extruded
      // side-profile body, wide rear haunches over fat rear wheels, side
      // air intakes, a prominent rear wing, slim headlight bars, an
      // exposed dark engine block and a full-width rear light strip.
      const car = new THREE.Group();
      car.rotation.order = "YXZ"; // yaw first, then terrain pitch, then roll
      const paint = new THREE.MeshStandardMaterial({ color: 0xffc400, metalness: 0.35, roughness: 0.32 });
      const carbonMat = new THREE.MeshStandardMaterial({ color: 0x0b0d12, metalness: 0.5, roughness: 0.45 });
      const glassMat = new THREE.MeshStandardMaterial({ color: 0x0a1626, metalness: 0.9, roughness: 0.12 });
      const chromeMat = new THREE.MeshStandardMaterial({ color: 0xc7ced9, metalness: 0.85, roughness: 0.25 });
      // Everything except the wheels; this group leans in turns.
      const bodyGroup = new THREE.Group();
      car.add(bodyGroup);
      const addPart = (geo, mat, x, y, z) => {
        const m = new THREE.Mesh(geo, mat);
        m.position.set(x, y, z);
        m.castShadow = true;
        bodyGroup.add(m);
        return m;
      };
      // Main body: side profile (nose at +x) extruded across the width,
      // then rotated so the profile's +x becomes the car's +z (forward).
      const profile = new THREE.Shape();
      profile.moveTo(-2.2, 0.24);
      profile.lineTo(2.18, 0.24);
      profile.lineTo(2.28, 0.44);   // nose tip
      profile.lineTo(0.5, 0.68);    // hood line
      profile.lineTo(-1.5, 0.74);   // rear deck
      profile.lineTo(-2.2, 0.64);
      profile.closePath();
      const bodyGeo = new THREE.ExtrudeGeometry(profile, { depth: 1.84, bevelEnabled: false });
      bodyGeo.translate(0, 0, -0.92);
      const bodyMain = new THREE.Mesh(bodyGeo, paint);
      bodyMain.rotation.y = -Math.PI / 2;
      bodyMain.castShadow = true;
      bodyGroup.add(bodyMain);
      // Black centre stripe over the hood/deck.
      addPart(new THREE.BoxGeometry(0.52, 0.03, 1.8), carbonMat, 0, 0.705, 0);
      // Glass canopy + black roof panel.
      addPart(new THREE.BoxGeometry(1.42, 0.4, 1.85), glassMat, 0, 0.9, -0.35);
      addPart(new THREE.BoxGeometry(1.3, 0.06, 1.1), carbonMat, 0, 1.12, -0.45);
      // Side skirts.
      addPart(new THREE.BoxGeometry(2.0, 0.16, 2.4), carbonMat, 0, 0.26, 0);
      // Wide rear haunches over the rear wheels + side air intakes.
      [-1.02, 1.02].forEach((dx) => {
        addPart(new THREE.BoxGeometry(0.3, 0.36, 1.6), paint, dx, 0.52, -1.35);
        addPart(new THREE.BoxGeometry(0.1, 0.32, 0.85), carbonMat, dx > 0 ? 1.0 : -1.0, 0.56, -0.45);
      });
      // Front splitter + dark intake mouth.
      addPart(new THREE.BoxGeometry(2.0, 0.09, 0.55), carbonMat, 0, 0.17, 2.1);
      addPart(new THREE.BoxGeometry(1.45, 0.2, 0.08), carbonMat, 0, 0.36, 2.24);
      // Slim aggressive headlight bars, angled in plan view.
      const lightMat = new THREE.MeshBasicMaterial({ color: 0xfef9c3 });
      [-0.52, 0.52].forEach((dx) => {
        const hl = addPart(new THREE.BoxGeometry(0.6, 0.07, 0.05), lightMat, dx, 0.52, 2.26);
        hl.rotation.y = dx > 0 ? -0.18 : 0.18;
        hl.castShadow = false;
      });
      // Rear: full-width light strip, exposed engine block, twin exhausts.
      const tailMat = new THREE.MeshBasicMaterial({ color: 0xff2a2a });
      const tail = addPart(new THREE.BoxGeometry(1.8, 0.09, 0.05), tailMat, 0, 0.66, -2.22);
      tail.castShadow = false;
      addPart(new THREE.BoxGeometry(1.5, 0.3, 0.22), carbonMat, 0, 0.44, -2.16);
      const exhaustGeo = new THREE.CylinderGeometry(0.06, 0.06, 0.22, 10);
      exhaustGeo.rotateX(Math.PI / 2);
      [-0.42, 0.42].forEach((dx) => addPart(exhaustGeo, chromeMat, dx, 0.3, -2.26));
      // Prominent rear wing: blade, struts and endplates.
      addPart(new THREE.BoxGeometry(2.15, 0.07, 0.52), carbonMat, 0, 1.14, -2.0);
      [-0.62, 0.62].forEach((dx) => addPart(new THREE.BoxGeometry(0.09, 0.44, 0.3), carbonMat, dx, 0.9, -2.0));
      [-1.06, 1.06].forEach((dx) => addPart(new THREE.BoxGeometry(0.05, 0.24, 0.56), carbonMat, dx, 1.14, -2.0));
      // Neon underglow (fake light, near-zero cost).
      const underglow = new THREE.Mesh(
        new THREE.PlaneGeometry(3.8, 5.2),
        new THREE.MeshBasicMaterial({ map: glowTexture, color: 0x22d3ee, transparent: true, opacity: 0.4, blending: THREE.AdditiveBlending, depthWrite: false })
      );
      underglow.rotation.x = -Math.PI / 2;
      underglow.position.y = 0.03;
      car.add(underglow);
      // Headlight beam.
      const beamLight = new THREE.SpotLight(0xbfe3ff, 90, 34, 0.55, 0.6, 1.4);
      beamLight.position.set(0, 0.65, 2.0);
      const beamTarget = new THREE.Object3D();
      beamTarget.position.set(0, 0, 14);
      car.add(beamTarget);
      beamLight.target = beamTarget;
      car.add(beamLight);
      // Wheels: slimmer fronts, fat rears. Spin uses each wheel's radius;
      // front pivots steer.
      const wheelMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.9 });
      const hubMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.7, roughness: 0.3 });
      const makeWheel = (radius, width) => {
        const geo = new THREE.CylinderGeometry(radius, radius, width, 20);
        geo.rotateZ(Math.PI / 2);
        const m = new THREE.Mesh(geo, wheelMat);
        const hubGeo = new THREE.CylinderGeometry(radius * 0.45, radius * 0.45, width + 0.02, 10);
        hubGeo.rotateZ(Math.PI / 2);
        m.add(new THREE.Mesh(hubGeo, hubMat));
        m.castShadow = true;
        return m;
      };
      const wheels = [];
      const frontPivots = [];
      [[-0.88, 1.35, 0.36, 0.3, true], [0.88, 1.35, 0.36, 0.3, true],
       [-0.95, -1.35, 0.42, 0.44, false], [0.95, -1.35, 0.42, 0.44, false]].forEach(([wx, wz, wr, ww, front]) => {
        const pivot = new THREE.Group();
        pivot.position.set(wx, wr, wz);
        const wheel = makeWheel(wr, ww);
        pivot.add(wheel);
        car.add(pivot);
        wheels.push({ mesh: wheel, r: wr });
        if (front) frontPivots.push(pivot);
      });
      scene.add(car);

      // ---- Driving state & input ---------------------------------------------
      const SPAWN = { x: 0, z: 17, h: Math.PI }; // facing the CONTACT pad (north)
      const carState = {
        x: SPAWN.x, z: SPAWN.z, h: SPAWN.h, speed: 0, steer: 0,
        // Terrain/air state: y is the car origin height, vy the ballistic
        // vertical velocity while airborne, vyTrack the ground-following
        // vertical velocity while grounded (seeds the launch velocity).
        y: 0, vy: 0, vyTrack: 0, grounded: true,
        pitch: 0, roll: 0, settleT: -1,
      };
      const resetCar = () => {
        carState.x = SPAWN.x;
        carState.z = SPAWN.z;
        carState.h = SPAWN.h;
        carState.speed = 0;
        carState.steer = 0;
        carState.y = 0;
        carState.vy = 0;
        carState.vyTrack = 0;
        carState.grounded = true;
        carState.pitch = 0;
        carState.roll = 0;
        carState.settleT = -1;
      };
      const keys = new Set();
      const touchKeys = { up: false, down: false, left: false, right: false };
      let engaged = false;

      const setEngaged = (on) => {
        engaged = on;
        if (!on) {
          // Released mid-air or mid-slope: settle the car onto the ground
          // where it sits so the attract view never shows it floating.
          carState.y = groundHeightAt(carState.x, carState.z);
          carState.vy = 0;
          carState.vyTrack = 0;
          carState.grounded = true;
        }
        overlay.hidden = on;
        exitBtn.hidden = !on;
        touchUI.hidden = !(on && isTouch);
        wrap.style.touchAction = on ? "none" : "";
        if (on) canvas.focus?.();
      };
      if (reducedMotion) {
        // No driving for reduced-motion users: a static framed view, and the
        // full content lives in the sections below (as it always did).
        overlay.hidden = true;
        if (hint) hint.textContent = "A drivable 3D version of this portfolio is available, but motion is reduced in your settings — everything it contains is written out in the sections below.";
      } else {
        overlay.addEventListener("click", () => setEngaged(true));
        exitBtn.addEventListener("click", () => setEngaged(false));
      }
      window.addEventListener("keydown", (e) => {
        if (!engaged) return;
        if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Space"].includes(e.code)) e.preventDefault();
        if (e.code === "Escape") { setEngaged(false); return; }
        if (e.code === "KeyR") { resetCar(); return; }
        keys.add(e.code);
      });
      window.addEventListener("keyup", (e) => keys.delete(e.code));
      window.addEventListener("blur", () => keys.clear());
      touchUI.querySelectorAll("button[data-k]").forEach((btn) => {
        const k = btn.dataset.k;
        const on = (e) => { e.preventDefault(); touchKeys[k] = true; };
        const off = (e) => { e.preventDefault(); touchKeys[k] = false; };
        btn.addEventListener("touchstart", on, { passive: false });
        btn.addEventListener("touchend", off, { passive: false });
        btn.addEventListener("touchcancel", off, { passive: false });
        btn.addEventListener("mousedown", on);
        btn.addEventListener("mouseup", off);
        btn.addEventListener("mouseleave", off);
      });

      // ---- Panel --------------------------------------------------------------
      let currentZone = null;
      const openPanel = (zo) => {
        panelKicker.textContent = "Portfolio zone";
        panelTitle.textContent = zo.zone.title;
        panelText.textContent = zo.zone.text;
        panel.hidden = false;
      };
      panelClose.addEventListener("click", () => { panel.hidden = true; });

      // ---- Physics --------------------------------------------------------------
      const CAR_R = 1.35;
      const stepPhysics = (dt) => {
        const fwd = keys.has("KeyW") || keys.has("ArrowUp") || touchKeys.up;
        const back = keys.has("KeyS") || keys.has("ArrowDown") || touchKeys.down;
        const left = keys.has("KeyA") || keys.has("ArrowLeft") || touchKeys.left;
        const right = keys.has("KeyD") || keys.has("ArrowRight") || touchKeys.right;
        const brake = keys.has("Space");

        const MAX_FWD = 24, MAX_REV = 9;
        if (engaged) {
          if (fwd) carState.speed += 16 * dt;
          else if (back) carState.speed -= carState.speed > 0.5 ? 22 * dt : 10 * dt;
          if (brake) {
            const s = Math.sign(carState.speed);
            carState.speed -= s * 34 * dt;
            if (Math.sign(carState.speed) !== s) carState.speed = 0;
          }
        }
        // Rolling drag + friction always apply.
        carState.speed -= carState.speed * 0.7 * dt;
        if (!fwd && !back) carState.speed -= Math.sign(carState.speed) * Math.min(Math.abs(carState.speed), 5 * dt);
        carState.speed = THREE.MathUtils.clamp(carState.speed, -MAX_REV, MAX_FWD);
        if (Math.abs(carState.speed) < 0.02 && !fwd && !back) carState.speed = 0;

        // Steering: less twitchy at speed; the car only turns while moving.
        const steerInput = (left ? 1 : 0) - (right ? 1 : 0);
        const speedFactor = 1 - Math.min(Math.abs(carState.speed) / MAX_FWD, 1) * 0.45;
        const steerTarget = steerInput * 0.55 * speedFactor;
        carState.steer += (steerTarget - carState.steer) * Math.min(1, dt * 10);
        if (Math.abs(carState.speed) > 0.05) {
          carState.h += (carState.speed / 2.7) * Math.tan(carState.steer) * dt;
        }

        const prevX = carState.x;
        const prevZ = carState.z;
        carState.x += Math.sin(carState.h) * carState.speed * dt;
        carState.z += Math.cos(carState.h) * carState.speed * dt;

        // World bounds.
        const lim = LOT - 1.6;
        if (carState.x < -lim) { carState.x = -lim; carState.speed *= 0.4; }
        if (carState.x > lim) { carState.x = lim; carState.speed *= 0.4; }
        if (carState.z < -lim) { carState.z = -lim; carState.speed *= 0.4; }
        if (carState.z > lim) { carState.z = lim; carState.speed *= 0.4; }

        // ---- Terrain following, ramp launches and landings ----------------
        // Grounded: the car's height tracks the sampled ground height and
        // vyTrack records how fast that height is changing — climbing a
        // ramp builds real upward velocity. When the ground falls away
        // faster than the slope the car was following (the ramp lip),
        // the car goes ballistic with that velocity and gravity takes over.
        const GRAV = 26;
        const prevY = carState.y;
        const prevVy = carState.vyTrack;
        let gH = groundHeightAt(carState.x, carState.z);
        if (carState.grounded) {
          if (gH >= prevY - 0.001) {
            if (gH - prevY > 0.5) {
              // Too tall to climb in one step (a wedge side or back face):
              // treat it as a wall — undo the move and scrub speed.
              carState.x = prevX;
              carState.z = prevZ;
              carState.speed *= 0.3;
              gH = groundHeightAt(carState.x, carState.z);
            }
            carState.y = gH;
            carState.vyTrack = dt > 0 ? (carState.y - prevY) / dt : 0;
            if (prevVy < -4.5 && Math.abs(carState.vyTrack) < 1) carState.settleT = 0; // thump at a ramp base
          } else if (prevVy > 0.6 || prevY - gH > 0.3) {
            // Ground dropped away under a climbing (or cresting) car.
            carState.grounded = false;
            carState.vy = Math.max(prevVy, 0);
            carState.vyTrack = 0;
          } else {
            // Gentle descent: stay glued to the slope.
            carState.y = gH;
            carState.vyTrack = dt > 0 ? (carState.y - prevY) / dt : 0;
          }
        }
        if (!carState.grounded) {
          carState.vy -= GRAV * dt;
          carState.y += carState.vy * dt;
          if (carState.y <= gH) {
            const impact = -carState.vy;
            carState.y = gH;
            carState.grounded = true;
            carState.vy = 0;
            carState.vyTrack = 0;
            if (impact > 5) { carState.settleT = 0; carState.speed *= 0.94; }
          }
        }

        // Obstacles: circle vs AABB. Skipped while flying above prop height,
        // so a good launch clears the cones and crates.
        const skipProps = !carState.grounded && carState.y > 1.5;
        for (const ob of obstacles) {
          if (skipProps) break;
          if (ob.dead) continue;
          const cx = THREE.MathUtils.clamp(carState.x, ob.x - ob.hx, ob.x + ob.hx);
          const cz = THREE.MathUtils.clamp(carState.z, ob.z - ob.hz, ob.z + ob.hz);
          const dx = carState.x - cx;
          const dz = carState.z - cz;
          const d2 = dx * dx + dz * dz;
          if (d2 >= CAR_R * CAR_R) continue;
          const impact = Math.abs(carState.speed);
          if (d2 > 1e-6) {
            const d = Math.sqrt(d2);
            carState.x = cx + (dx / d) * CAR_R;
            carState.z = cz + (dz / d) * CAR_R;
            if (ob.tippable && impact > 3) {
              ob.dead = true;
              ob.tipT = 0;
              if (Math.abs(dx) > Math.abs(dz)) { ob.tipAxis = "z"; ob.tipDir = dx > 0 ? -1 : 1; }
              else { ob.tipAxis = "x"; ob.tipDir = dz > 0 ? 1 : -1; }
            }
          } else {
            // Car centre inside the box: push out along the smaller penetration.
            const px = ob.hx + CAR_R - Math.abs(carState.x - ob.x);
            const pz = ob.hz + CAR_R - Math.abs(carState.z - ob.z);
            if (px < pz) carState.x = ob.x + Math.sign(carState.x - ob.x || 1) * (ob.hx + CAR_R);
            else carState.z = ob.z + Math.sign(carState.z - ob.z || 1) * (ob.hz + CAR_R);
            if (ob.tippable && impact > 3) { ob.dead = true; ob.tipT = 0; ob.tipAxis = "x"; ob.tipDir = 1; }
          }
          carState.speed *= 0.3;
        }

        // Terrain pitch & roll while grounded (sampled ahead/behind and
        // left/right of the car); ballistic pitch while airborne.
        const fX = Math.sin(carState.h), fZ = Math.cos(carState.h);
        const rX = Math.cos(carState.h), rZ = -Math.sin(carState.h);
        let targetPitch = 0;
        let targetRoll = 0;
        if (carState.grounded) {
          const hF = groundHeightAt(carState.x + fX * 1.25, carState.z + fZ * 1.25);
          const hB = groundHeightAt(carState.x - fX * 1.25, carState.z - fZ * 1.25);
          targetPitch = Math.atan2(hF - hB, 2.5);
          const hR = groundHeightAt(carState.x + rX * 0.85, carState.z + rZ * 0.85);
          const hL = groundHeightAt(carState.x - rX * 0.85, carState.z - rZ * 0.85);
          targetRoll = Math.atan2(hR - hL, 1.7);
        } else {
          targetPitch = Math.atan2(carState.vy, Math.max(Math.abs(carState.speed), 5)) * 0.6;
        }
        const blend = 1 - Math.exp(-(carState.grounded ? 14 : 7) * dt);
        carState.pitch += (targetPitch - carState.pitch) * blend;
        carState.roll += (targetRoll - carState.roll) * blend;
        // Landing settle: a quick suspension dip after a hard touchdown.
        let dip = 0;
        if (carState.settleT >= 0) {
          carState.settleT += dt / 0.28;
          const k = Math.min(carState.settleT, 1);
          dip = -0.07 * Math.sin(k * Math.PI) * (1 - k * 0.4);
          if (k >= 1) carState.settleT = -1;
        }

        // Sync meshes.
        car.position.set(carState.x, carState.y + dip, carState.z);
        car.rotation.y = carState.h;
        car.rotation.x = -carState.pitch;
        car.rotation.z = carState.roll;
        bodyGroup.rotation.z = -carState.steer * Math.min(Math.abs(carState.speed) / MAX_FWD, 1) * 0.35;
        wheels.forEach((w) => { w.mesh.rotation.x += (carState.speed / w.r) * dt; });
        frontPivots.forEach((p) => { p.rotation.y = carState.steer * 0.9; });

        // Zone pads.
        let found = null;
        for (const zo of zoneObjs) {
          const dx = carState.x - zo.zone.x;
          const dz = carState.z - zo.zone.z;
          if (dx * dx + dz * dz < 3.4 * 3.4) { found = zo; break; }
        }
        if (found !== currentZone) {
          currentZone = found;
          if (found) openPanel(found);
        }
      };

      // ---- Camera & loop ------------------------------------------------------------
      const camPos = new THREE.Vector3(24, 16, 28);
      const camTarget = new THREE.Vector3();
      let sceneVisible = true;
      if ("IntersectionObserver" in window) {
        new IntersectionObserver((entries) => { sceneVisible = entries[0].isIntersecting; }, { threshold: 0.02 }).observe(wrap);
      }
      const resize = () => {
        const w = wrap.clientWidth;
        const h = wrap.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      window.addEventListener("resize", resize);

      const clock = new THREE.Clock();
      const renderFrame = (t) => {
        // Tip-over animation for struck props.
        for (const ob of obstacles) {
          if (ob.tipT < 0) continue;
          ob.tipT += 1 / 60 / 0.45;
          const k = Math.min(ob.tipT, 1);
          const angle = (1 - Math.pow(1 - k, 2)) * (Math.PI / 2) * 0.96;
          if (ob.tipAxis === "x") ob.mesh.rotation.x = angle * ob.tipDir;
          else ob.mesh.rotation.z = angle * ob.tipDir;
          if (k >= 1) ob.tipT = -1;
        }
        // Zone pad glow: pulse the active pad, breathe the rest.
        for (const zo of zoneObjs) {
          const isActive = zo === currentZone;
          zo.pad.material.emissiveIntensity = isActive ? 0.85 + Math.sin(t * 6) * 0.25 : 0.25 + Math.sin(t * 1.6 + zo.zone.x) * 0.07;
          const s = isActive ? 1.12 : 1;
          zo.ring.scale.set(s, s, 1);
        }
        if (engaged) {
          const fx = Math.sin(carState.h), fz = Math.cos(carState.h);
          camTarget.set(carState.x - fx * 9.5, 4.6 + carState.y * 0.85, carState.z - fz * 9.5);
          camPos.lerp(camTarget, 1 - Math.exp(-3.2 * (1 / 60)));
          camera.position.copy(camPos);
          camera.lookAt(carState.x + fx * 4, 1.1 + carState.y, carState.z + fz * 4);
        } else {
          const a = t * 0.07;
          camera.position.set(Math.sin(a) * 31, 13.5, Math.cos(a) * 31);
          camera.lookAt(0, 0.5, 0);
          camPos.copy(camera.position);
        }
        renderer.render(scene, camera);
      };

      if (reducedMotion) {
        car.position.set(carState.x, 0, carState.z);
        car.rotation.y = carState.h;
        camera.position.set(23, 16, 27);
        camera.lookAt(0, 0.5, 0);
        renderer.render(scene, camera); // single static frame
      } else {
        const animate = () => {
          requestAnimationFrame(animate);
          const dt = Math.min(clock.getDelta(), 0.05);
          if (!sceneVisible) return;
          if (engaged) stepPhysics(dt);
          else {
            car.position.set(carState.x, carState.y, carState.z);
            car.rotation.y = carState.h;
            car.rotation.x = -carState.pitch;
            car.rotation.z = carState.roll;
          }
          renderFrame(clock.elapsedTime);
        };
        animate();
      }
    } catch {
      // WebGL unavailable: hide the canvas; the hero text and all sections stand on their own.
      canvas.style.display = "none";
      const ov = document.getElementById("drive-overlay");
      if (ov) ov.style.display = "none";
    }
  }
</script>
