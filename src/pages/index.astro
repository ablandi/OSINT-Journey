---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { sortPosts } from "../utils/posts";

const posts = sortPosts(await getCollection("blog")).slice(0, 3);
---

<BaseLayout
  title="OSINT Journey"
  description="Documenting my journey learning open source intelligence (OSINT)."
>
  <section class="hero">
    <h1>My Journey Through OSINT and A Nod to the Antihuman Trafficking Fight</h1>
    <p>What started as a gut-punch reaction to a documentary turned into a mission: learning the skills to actually help. This blog tracks that journey — the books that shaped my thinking, the OSINT techniques and certifications I'm building along the way, and the mindset behind using online research for good.</p>
  </section>
  <section>
    <h2>Recent posts</h2>
    <PostList posts={posts} />
    <p><a href="/blog">View all posts &rarr;</a></p>
  </section>
</BaseLayout>
