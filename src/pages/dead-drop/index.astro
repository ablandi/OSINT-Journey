---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Dead Drop"
  description="Nothing to see here."
>
  <!-- the photo remembers more than it shows -->
  <article style="max-width: 640px; margin: 4rem auto; text-align: center; padding: 0 1rem;">
    <p style="color: #666; font-style: italic;">Nothing to see here.</p>
    <figure style="margin: 2rem 0;">
      <img
        src="/images/dead-drop.jpg"
        alt="A rotary telephone on a desk in a dark room"
        style="max-width: 100%; border-radius: 4px;"
      />
    </figure>
    <p style="color: #666; font-style: italic;">Move along.</p>
  </article>
</BaseLayout>
