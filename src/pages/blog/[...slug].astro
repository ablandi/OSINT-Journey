---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, isoDate } from "../../utils/date";
import { slugifyTag } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate(post.data.pubDate),
  author: { "@type": "Person", name: "Alonza Blanding" },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(post.data.pubDate)} />
    {post.data.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article>
    <header>
      <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1>
      {
        post.data.tags && post.data.tags.length > 0 && (
          <p class="post-tags">
            {post.data.tags.map((tag) => (
              <a href={`/blog/tags/${slugifyTag(tag)}`}>{tag}</a>
            ))}
          </p>
        )
      }
    </header>
    <Content />
    <footer class="post-footer">
      <p><a href="/blog">&larr; All posts</a></p>
    </footer>
  </article>
</BaseLayout>
