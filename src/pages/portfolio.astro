---
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioScene from "../components/PortfolioScene.astro";
---

<BaseLayout
  title="Portfolio"
  description="Portfolio of Alonza Blanding Jr. — cybersecurity and OSINT analyst working in open source intelligence and counter-trafficking."
>
  <section class="portfolio-hero">
    <PortfolioScene />
    <h1>Alonza Blanding Jr.</h1>
