---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/og-image.jpg" } = Astro.props;
const pageTitle = title === "OSINT Journey" ? title : `${title} | OSINT Journey`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="OSINT Journey" href={new URL("rss.xml", Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OSINT Journey" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="brand">OSINT Journey</a>
        <div class="links">
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        <a href="https://www.linkedin.com/in/alonza-blanding-124876118">LinkedIn</a>
        &middot;
        <a href="/rss.xml">RSS</a>
      </p>
      <p>&copy; {new Date().getFullYear()} OSINT Journey. Built with Astro.</p>
    </footer>
  </body>
</html>
